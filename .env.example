# Bu dosyayı ".env" adıyla kopyala ve doldur.
# .env ASLA git'e gönderilmez (.gitignore'da). Kişisel/gizli her şey burada.

# @BotFather -> /mybots -> API Token
BOT_TOKEN=

# Yönetici Telegram kullanıcı id'leri (virgülle ayır).
# Öğrenmek için: bota özel sohbette /chatid yaz.
ADMIN_IDS=

# Sabah duyurusunun gideceği grup. Grup id'leri eksi ile başlar.
# Öğrenmek için: gruba /chatid@BOTADIN yaz.
# Boş bırakılırsa sabah duyurusu kurulmaz.
GROUP_CHAT_ID=
