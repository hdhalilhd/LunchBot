# Bu dosyayi ".env" adiyla kopyala ve kendi degerlerini yaz.
# .env dosyasi ASLA git'e gonderilmez (.gitignore'da).

# @BotFather -> /newbot ile aldigin token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Her sabah mesajin gidecegi grubun id'si.
# Gruplarin id'si eksi ile baslar, ornek: -1001234567890
# Ogrenmek icin: python scripts/chat_id.py
GROUP_CHAT_ID=-1001234567890
